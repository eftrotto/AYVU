# Copie este arquivo pra ".env" (que já está no .gitignore) e preencha com
# a connection string de verdade. Sem essa variável, o backend usa SQLite
# local (backend/ayvu.db) — não precisa disso pra rodar localmente sozinho.

# String do Supabase: Project Settings -> Database -> Connection string -> URI
# Tanto "Direct connection" quanto "Session pooler" funcionam aqui. Evite a
# "Transaction pooler" (pgbouncer em modo transaction não suporta prepared
# statements, que o driver psycopg usa por padrão).
DATABASE_URL=postgresql://postgres:SUA_SENHA_AQUI@host:porta/postgres
